# ---------------------------------------------------------------- #
# Escola Nova Geração — sistema de matrículas
# ---------------------------------------------------------------- #
AMBIENTE=homologacao          # sandbox | homologacao | producao
PORTA=3000
ARQUIVOS_DIR=./arquivos
CONFIA_PROXY=false            # true somente atrás de proxy reverso confiável
COOKIE_SEGURO=true            # false apenas em desenvolvimento sem HTTPS

# Banco — dois papéis por decisão de segurança.
# A aplicação usa ng_app, que NÃO é dono de nenhuma tabela e portanto
# não escapa do RLS. Migração e seed usam ng_owner.
DATABASE_URL=postgres://ng_app:SENHA@localhost:5432/novageracao
DATABASE_URL_OWNER=postgres://ng_owner:SENHA@localhost:5432/novageracao
DB_POOL_MAX=10

# Primeiro acesso (usado só pelo seed)
SEED_EMAIL_DIRECAO=direcao@novageracaoitu.com.br
SEED_SENHA_DIRECAO=            # mínimo 12 caracteres; trocar no primeiro login

SESSAO_HORAS=10
PDF_CONCORRENCIA=2

# ---------------------------------------------------------------- #
# Docusign eSignature — JWT Grant
# ---------------------------------------------------------------- #
DS_MODO=mock                          # mock | real
DS_OAUTH_BASE=account-d.docusign.com  # account.docusign.com em produção
DS_INTEGRATION_KEY=
DS_USER_ID=
DS_PRIVATE_KEY=                       # PEM com \n escapado; em produção, do cofre
DS_WEBHOOK=https://matriculas.novageracaoitu.com.br/ds/webhook
DS_CONNECT_HMAC=                      # obrigatório em produção
